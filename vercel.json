{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [{ "src": "/[^.]+", "dest": "/index.html", "status": 200 }],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://wedding-invitation-kj.vercel.app/$1",
      "permanent": true
    }
  ]
}
